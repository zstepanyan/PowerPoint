CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -Iinclude -Iexternal
LDFLAGS = 

# Source files
CORE_SRCS = src/core/Shape.cpp src/core/Slide.cpp src/core/SlideFactory.cpp src/core/SlideRepository.cpp
CMD_SRCS = src/commands/Commands.cpp
PARSE_SRCS = src/parser/Lexer.cpp src/parser/Tokenizer.cpp src/parser/Parser.cpp
SER_SRCS = src/serialization/JsonSerializer.cpp
OTHER_SRCS = src/command factory/CommandFactory.cpp src/main.cpp

SRCS = $(CORE_SRCS) $(CMD_SRCS) $(PARSE_SRCS) $(SER_SRCS) $(OTHER_SRCS)
OBJS = $(SRCS:.cpp=.o)
TARGET = SlideEditor

.PHONY: all clean run

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

run: $(TARGET)
	./$(TARGET)

clean:
	rm -f $(OBJS) $(TARGET)

# For README
help:
	@echo "Available targets:"
	@echo "  all   - Build the SlideEditor application"
	@echo "  run   - Build and run SlideEditor"
	@echo "  clean - Remove build artifacts"
	@echo "  help  - Show this help message"